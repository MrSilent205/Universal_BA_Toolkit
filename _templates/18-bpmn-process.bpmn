<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_OrderProcess"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BA-Kit BPMN Engine"
                  exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_01">
    <bpmn:participant id="Participant_Order" name="Quy trình Xử lý Đơn hàng" processRef="Process_Order" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Order" isExecutable="true">
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Customer" name="Khách hàng">
        <bpmn:flowNodeRef>StartEvent_OrderPlaced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_FillAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="Hệ thống Backend">
        <bpmn:flowNodeRef>ServiceTask_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StockCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ProcessPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OutOfStock</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_OrderPlaced" name="Khách bấm Đặt hàng">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_FillAddress" name="Nhập thông tin giao nhận">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_CheckStock" name="Kiểm tra tồn kho khả dụng">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Tồn kho đủ?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_StockYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_StockNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_ProcessPayment" name="Xử lý giao dịch thanh toán">
      <bpmn:incoming>Flow_StockYes</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_OutOfStock" name="Hết hàng (Hủy)">
      <bpmn:incoming>Flow_StockNo</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Đặt hàng thành công">
      <bpmn:incoming>Flow_04</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_OrderPlaced" targetRef="UserTask_FillAddress" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="UserTask_FillAddress" targetRef="ServiceTask_CheckStock" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="ServiceTask_CheckStock" targetRef="Gateway_StockCheck" />
    <bpmn:sequenceFlow id="Flow_StockYes" name="Có" sourceRef="Gateway_StockCheck" targetRef="ServiceTask_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_StockNo" name="Không" sourceRef="Gateway_StockCheck" targetRef="EndEvent_OutOfStock" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="ServiceTask_ProcessPayment" targetRef="EndEvent_OrderCompleted" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_01">
      <bpmndi:BPMNShape id="Participant_Order_di" bpmnElement="Participant_Order" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="800" height="350" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
